# MongoDB Atlas connection string (Atlas → Connect → Drivers → Python)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=elever

# Shared secret the Next.js app sends as the x-api-key header.
# Must match API_KEY in the Next.js .env.local. Leave empty only for local development.
API_KEY=

# Interactive API docs at /docs. Set to false in production.
DOCS_ENABLED=true

# Restaurant rules
TIMEZONE=America/New_York
SLOT_CAPACITY=20
BOOKING_WINDOW_DAYS=60
ORDER_PREP_MINUTES=25
